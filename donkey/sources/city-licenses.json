{
  "id": "city-licenses",
  "name": "City business licenses (scored)",
  "description": "A city business license list with issue dates (public records request). Same columns as city-business-list; each row is also a new_license event dated the issue date, which call-this-week scores for 60 days (licenses dated Jan 1 are taken as annual renewals and never score).",
  "format": "csv",
  "columns": {
    "name": ["Business Name", "Name", "Business"],
    "address": ["Address", "Business Address"],
    "street": ["Street", "Street Address", "Address"],
    "city": ["City", "Town"],
    "state": ["State"],
    "zip": ["ZIP", "Zip Code", "Postal Code"],
    "license_number": ["License No", "License Number", "Permit Number"],
    "open_date": ["Open Date", "Issue Date", "Start Date"],
    "naics": ["NAICS", "NAICS Code"],
    "vertical": ["Vertical", "Business Type"],
    "contact_name": ["Contact Name", "Contact"],
    "contact_title": ["Contact Title", "Title"],
    "contact_email": ["Email", "Contact Email"],
    "contact_phone": ["Phone", "Contact Phone"],
    "phone": ["Business Phone"],
    "website": ["Website", "Web", "URL"],
    "event_date": ["Issue Date", "Open Date", "Start Date"],
    "legal_name": ["Legal Name"],
    "classification": ["Classification"]
  },
  "required": ["name", "event_date"],
  "event": {
    "kind": "new_license",
    "date": "event_date",
    "town": "city",
    "details": ["name", "legal_name", "zip", "street", "license_number", "classification"]
  }
}
